pipeline {
    agent {
        docker {
            image 'gradle:7.5.1-jdk11'
            args '-v /var/jenkins_home:/var/jenkins_home'
        }
    }
    environment {
        GRADLE_HOME = tool(name: 'gradle', type: 'gradle')
        DOCKER_TOOL = tool(name: 'docker', type: 'dockerTool')
        MODULES = "hw01-gradle,hw02-gradle,hw03-gradle,hw04-gradle,hw05-json-gradle,hw06-dsl-gradle,hw07-gradle"
        DOCKER_REGISTRY = 'groovydeveloper'
    }

    stages {
        stage('PrintSysTime') {
            steps {
                script {
                    def now = java.time.LocalDateTime.now()
                    def time = now.format(java.time.format.DateTimeFormatter.ofPattern("HH:mm:ss dd.MM.yyyy"))
                    echo "time: ${time}"
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    def processModules = { closure ->
                        env.MODULES.split(",").each { module ->
                            echo "module name: ${module}"
                            closure(module)
                        }
                    }
                    processModules { module ->
                        sh "${GRADLE_HOME}/bin/gradle ${module}:clean ${module}:build"
                    }
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    def processModules = { closure ->
                        env.MODULES.split(",").each { module ->
                            echo "module name: ${module}"
                            closure(module)
                        }
                    }
                    processModules { module ->
                        sh "${GRADLE_HOME}/bin/gradle ${module}:test"
                    }
                }
            }
        }

        stage('Archive') {
            steps {
                script {
                    def processModules = { closure ->
                        env.MODULES.split(",").each { module ->
                            echo "module name: ${module}"
                            closure(module)
                        }
                    }
                    processModules { module ->
                        archiveArtifacts artifacts: "${module}/build/libs/*.jar", allowEmptyArchive: false
                    }
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                script {
                    sh "${DOCKER_TOOL} version"
                    def processModules = { closure ->
                        env.MODULES.split(",").each { module ->
                            echo "module name: ${module}"
                            closure(module)
                        }
                    }
                    processModules { module ->
                        sh "${DOCKER_TOOL}/docker build -t ${env.DOCKER_REGISTRY}/${module}:latest ."
                    }
                }
            }
        }

        stage('Docker Login') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', 'docker_credentials') {
                        echo 'Logged into Docker Hub'
                    }
                }
            }
        }

        stage('Push Docker Images') {
            steps {
                script {
                    def processModules = { closure ->
                        env.MODULES.split(",").each { module ->
                            echo "module name: ${module}"
                            closure(module)
                        }
                    }
                    processModules { module ->
                        sh "${DOCKER_TOOL}/docker push ${env.DOCKER_REGISTRY}/${module}:latest"
                    }
                }
            }
        }
    }
}
